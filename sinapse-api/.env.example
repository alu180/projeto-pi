# String de conexão com o banco MySQL.
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
#
# Para rodar localmente:
# 1. Instale o MySQL Server
# 2. Crie o banco vazio: CREATE DATABASE sinapse;
# 3. Copie este arquivo para .env (cp .env.example .env)
# 4. Substitua SUA_SENHA pela senha real do seu root MySQL
DATABASE_URL="mysql://root:SUA_SENHA@localhost:3306/sinapse"